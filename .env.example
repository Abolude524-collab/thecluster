# The Cluster Environment Configuration

# Application Mode: 'development' (uses mock API) or 'production' (uses real provider APIs)
VITE_APP_ENV=development

# Simulated Latency Configuration (ms)
VITE_MOCK_LATENCY_MIN=400
VITE_MOCK_LATENCY_MAX=1200

# Future Production Provider OAuth Credentials (Handled Server-Side in Production)
VITE_YOUTUBE_CLIENT_ID=your_google_client_id_placeholder
VITE_INSTAGRAM_CLIENT_ID=your_meta_client_id_placeholder
VITE_X_CLIENT_ID=your_x_client_id_placeholder
